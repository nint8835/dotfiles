font-family = "PragmataPro Mono"
font-size = 14
font-thicken = true
theme = {{ if .isNixOS }}noctalia{{ else }}"Catppuccin Frappe"{{ end }}
unfocused-split-opacity = 1
# 1GB - change to unlimited once unlimited scrollback is a thing
scrollback-limit = 1073741824

macos-titlebar-style = "tabs"
macos-icon = "custom-style"
# Catppuccin Frappe background
macos-icon-screen-color = "#303446"
# Catppuccin Frappe palette #1
macos-icon-ghost-color = "#e78284"

{{ if eq .chezmoi.os "linux" -}}
gtk-titlebar-style = tabs
window-theme = ghostty
gtk-wide-tabs = false
{{ end -}}
