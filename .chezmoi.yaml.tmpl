{{- $isNixOS := false -}}
{{- $isDebian := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $isNixOS = eq .chezmoi.osRelease.id "nixos" -}}
{{-   $isDebian = eq .chezmoi.osRelease.id "debian" -}}
{{- end -}}
{{ $user_email := promptStringOnce . "user.email" "Email address" "riley@rileyflynn.me" }}

{{ if $isNixOS -}}
sourceDir: {{ joinPath .chezmoi.homeDir "dotfiles" | quote }}
{{ end -}}

data:
    isNixOS: {{ $isNixOS }}
    isDebian: {{ $isDebian }}
    user:
        email: {{ $user_email | quote }}
