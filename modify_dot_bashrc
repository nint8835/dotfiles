# chezmoi:modify-template
{{- $block := `# >>> chezmoi managed >>>
# Mise tools for interactive Bash shells.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi
# <<< chezmoi managed <<<
` -}}
{{- $pattern := `(?ms)^# >>> chezmoi managed >>>
.*?^# <<< chezmoi managed <<<(?:
|$)` -}}
{{- if regexMatch $pattern .chezmoi.stdin -}}
{{ regexReplaceAllLiteral $pattern .chezmoi.stdin $block }}
{{- else -}}
{{ printf "%s\n%s" .chezmoi.stdin $block }}
{{- end -}}
